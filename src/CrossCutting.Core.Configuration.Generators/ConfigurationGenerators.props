<!-- Import this props file from projects that define [ConfigurationCategory] types. -->
<Project>
  <PropertyGroup>
    <_CoCoConfigurationGeneratorsDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)'))</_CoCoConfigurationGeneratorsDir>
    <_CoCoConfigurationGeneratorsDll>$(_CoCoConfigurationGeneratorsDir)bin/$(Configuration)/netstandard2.0/CrossCutting.Core.Configuration.Generators.dll</_CoCoConfigurationGeneratorsDll>
  </PropertyGroup>

  <!--
    Publish passes RuntimeIdentifier globally. The generator targets netstandard2.0 and must
    stay on the non-RID output path that this file loads as an analyzer.
  -->
  <ItemGroup>
    <ProjectReference Include="$(_CoCoConfigurationGeneratorsDir)CrossCutting.Core.Configuration.Generators.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all"
                      Properties="RuntimeIdentifier=;PublishAot=false" />
  </ItemGroup>

  <Target Name="BuildCoCoConfigurationGenerators"
          BeforeTargets="ResolvePackageDependenciesForBuild;BeforeCompile;CoreCompile">
    <MSBuild Projects="$(_CoCoConfigurationGeneratorsDir)CrossCutting.Core.Configuration.Generators.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=;TargetRuntimeIdentifier=;PublishAot=false" />
    <ItemGroup>
      <Analyzer Include="$(_CoCoConfigurationGeneratorsDll)" />
    </ItemGroup>
  </Target>
</Project>
